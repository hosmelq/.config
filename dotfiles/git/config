[commit]
    gpgsign = true
[core]
    ignorecase = false
    pager = delta
[credential "https://gist.github.com"]
    helper =
    helper = !/opt/homebrew/bin/mise exec -- gh auth git-credential
[credential "https://github.com"]
    helper =
    helper = !/opt/homebrew/bin/mise exec -- gh auth git-credential
[delta]
    navigate = true
[gpg]
    format = ssh
[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[interactive]
    diffFilter = delta --color-only
[merge]
    conflictStyle = zdiff3
[mergetool]
    keepBackup = true
